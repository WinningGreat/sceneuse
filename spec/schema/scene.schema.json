{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sceneuse.dev/schema/scene.json",
  "title": "sceneuse scene",
  "type": "object",
  "required": ["v", "type", "seq", "t", "kind", "permissions", "cursor", "focus", "damage", "tiles"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "scene" },
    "seq": { "type": "integer", "minimum": 1 },
    "t": { "type": "number" },
    "kind": { "type": "string", "enum": ["full", "delta"] },
    "permissions": { "$ref": "#/$defs/permissions" },
    "displays": {
      "type": "array",
      "items": { "$ref": "#/$defs/display" }
    },
    "windows": {
      "type": "array",
      "items": { "$ref": "#/$defs/window" }
    },
    "cursor": { "$ref": "#/$defs/cursor" },
    "focus": { "$ref": "#/$defs/focus" },
    "observe": { "$ref": "#/$defs/focus" },
    "damage": {
      "type": "array",
      "items": { "$ref": "#/$defs/rect" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "tiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/tile" }
    },
    "node_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["screen_recording", "accessibility"],
      "properties": {
        "screen_recording": { "type": "boolean" },
        "accessibility": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "required": ["id", "bounds", "scale"],
      "properties": {
        "id": { "type": "string" },
        "bounds": { "$ref": "#/$defs/rect" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "color_space": { "type": "string" }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["id", "pid", "app", "bounds", "z", "focused", "on_screen", "occluded"],
      "properties": {
        "id": { "type": "string" },
        "pid": { "type": "integer" },
        "app": { "type": "string" },
        "bundle": { "type": "string" },
        "title": { "type": "string" },
        "bounds": { "$ref": "#/$defs/rect" },
        "z": { "type": "integer", "minimum": 0 },
        "focused": { "type": "boolean" },
        "on_screen": { "type": "boolean" },
        "occluded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "required": ["x", "y", "visible"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "visible": { "type": "boolean" },
        "shape": { "type": "string" }
      },
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "window": { "type": ["string", "null"] },
        "app": { "type": ["string", "null"] },
        "pid": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "window", "role", "actions", "states"],
      "properties": {
        "id": { "type": "string" },
        "window": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "states": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bounds": { "$ref": "#/$defs/rect" },
        "parent": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "items": { "type": "string", "enum": ["target", "focus", "cursor", "changed"] },
          "description": "Salience hints. The full node list is still sent. Agents should weigh tagged nodes first."
        }
      },
      "additionalProperties": false
    },
    "tile": {
      "type": "object",
      "required": ["rect", "mime", "data"],
      "properties": {
        "rect": { "$ref": "#/$defs/rect" },
        "mime": { "type": "string", "const": "image/jpeg" },
        "data": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
